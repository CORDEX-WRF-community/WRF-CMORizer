&globalvars
   activity_id = "DD",   ! "DD", "FPS-URB-RCC CPRCM", "FPS-URB-RCC"
   contact = "email@institutional.com",
   Conventions = "CF-1.11",
   domain_id = "EUR-12",	
   att_domain = "Europe",
   driving_experiment_id = "evaluation",
   driving_experiment = "reanalysis simulation of the recent past", ! As per CV 
   driving_institution_id = "ECMWF",
   driving_source_id = "ERA5",
   driving_variant_label = "r1i1p1f1",   
   grid = "Rotated-pole latitude-longitude with 0.11 degree grid spacing", 	
   institution = "Institution name, City, Country",  ! As per CV https://wcrp-cordex.github.io/cordex-cmip6-cv/CORDEX-CMIP6_institution_id.html
   institution_id = "INST",                          ! As per CV https://wcrp-cordex.github.io/cordex-cmip6-cv/CORDEX-CMIP6_institution_id.html 
   license = "https://cordex.org/data-access/cordex-cmip6-data/cordex-cmip6-terms-of-use",
   mip_era = "CMIP6",
   product = "model-output",  
   project_id = "CORDEX-CMIP6",
   source = "Weather Research and Forecasting model version 4.6.1, CORDEX WRF Community configuration U",
   source_id = "WRF461U",
   source_type = "ARCM",
   version = "v20240703",
   version_realization = "v1-r1",
   references = "https://github.com/CORDEX-WRF-community/cordex-core-cmip6", ! Enter publication related to the simulation, or a website with configuration details
   comment = "Acknowledgement e.g. for the HPC and/or funding from projects. Any other special detail can be commented.",
/   

&filesystem
   DirInputSimResRoot = "../",
   DirOutputPostProRoot = "/set/full/path/to/output/dir",
   domain = "d01",  ! "d01", "d02", "d03"
   calendar = "standard",
/
&model_config
   ts = '0000',    ! any year can be used for pattern matching with filenames, set to '0000' to use all files that are found
   te = '0000',    ! any year can be used for pattern matching with filenames, set to '0000' to use all files that are found
   nx = 456,       ! domain_id raw output x-dim, incl. relaxation zone, unstaggered: west_east
   ny = 439,       ! domain_id raw output x-dim, incl. relaxation zone, unstaggered: south_north                    			  
   nz = 53,        ! number of vertical levels, unstaggered: bottom_top
   npl = 6,        ! number of pressure levels in wrfpress file
   xoffset = 10,                           	! zone to be cut away in x-dir. (e.g., boundary relax zone) spec_bdy_width
   yoffset = 10,                           	! many grps do not remove the boundary relaxation zone, in agreement with UCAN boundary relaxation zone is removed
   xfocus = 436,                          	! nx-2*xoffset
   yfocus = 419,                          	! ny-2*yoffset
   tstot = '1950-01-01_00:00:00',         	! start of the main time vector, per protocol, do not change
   tetot = '2101-01-01_00:00:00',         	! end of the main time vector, do not change
/
&static_fields
   PnFnGeo = '/set/full/path/to/geo_em.{domain}.nc',
   projection = 'ROT', ! 'LCC', 'ROT'
/
&tool_config
   nvar = 1,
   aggregation_yearly = .T.,              ! default CMOR, 1hr 3hr 6hr data are stored in yearly files
   aggregation_monthly = .F.,             ! data controls monthly files created
   aggregation_individually = .F.,        ! individual file is created, for the timespan as defined below
     tsact = '1998-01-01_00:00:00',       ! tsact and teact are only needed if aggregation_individually = .T.,
     teact = '1998-02-15_23:00:00',       ! set 1 timestep less - since extra timestep is needed for accumulated variables. Otherwise, the last timestep will be filled with missing values.
/
