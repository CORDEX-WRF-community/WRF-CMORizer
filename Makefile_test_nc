FC = mpifort
FCFLAGS = -O3
FCFLAGS += -I$(EBROOTNETCDFMINFORTRAN)/include
FCFLAGS += -I/p/scratch/cjjsc39/jjsc3900/sim/tmp2/tools/pCMORizer.f90/extLib/cdi210/include
LDFLAGS = -L$(EBROOTNETCDFMINFORTRAN)/lib -lnetcdff -lnetcdf
LDFLAGS += -L/p/scratch/cjjsc39/jjsc3900/sim/tmp2/tools/pCMORizer.f90/extLib/cdi210/lib -lcdi

PROGRAMS = test_nc

all: $(PROGRAMS)

%: %.o
	$(FC) $(FCFLAGS) -o $@ $^ $(LDFLAGS)

%.o: %.f90
	$(FC) $(FCFLAGS) -c $<

.PHONY: clean

clean:
	rm -rf *~ $(PROGRAMS)
